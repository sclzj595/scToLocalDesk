# ============================================================
# scToLocalDesk 编码固化：全库 UTF-8 无 BOM，杜绝 VS 在中文
# Windows（CP936）下默认按 GBK 存盘导致的乱码/坏文件
# VS2019+ 原生生效；已存在文件保留原编码，新文件按此创建
# ============================================================
root = true

[*]
charset = utf-8

# PS5.1 无 BOM 时按 ANSI 解析，中文注释会破坏语法——PS1 必须 BOM
[*.ps1]
charset = utf-8-bom
